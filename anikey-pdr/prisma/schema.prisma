// ANIKEY PDR: work authorization, completion & acceptance, invoice.
//
// Design notes
// - Every top-level table carries `orgId` (multi-tenant from day one; a single org today).
// - Money is stored as integer cents. Dates inside document payloads are ISO strings (YYYY-MM-DD).
// - A document (per job + type) has many immutable-after-signing versions.
// - Customer signing links are random tokens; only a SHA-256 hash is used for lookup.
// - AuditLog is append-only and hash-chained per organization.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
}

enum DocumentType {
  AUTHORIZATION
  COMPLETION
  INVOICE
}

enum VersionStatus {
  DRAFT
  SENT
  SIGNED
  SUPERSEDED
  VOID
}

enum JobStatus {
  AWAITING_AUTHORIZATION
  IN_PROGRESS
  AWAITING_ACCEPTANCE
  READY_TO_INVOICE
  INVOICED
  PAID
  CANCELLED
}

enum PaymentMethod {
  ACH
  CHECK
  CARD
  CASH
  OTHER
}

enum PhotoKind {
  BEFORE
  AFTER
  OTHER
}

enum ActorType {
  USER
  CUSTOMER
  SYSTEM
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  email                String
  phone                String?
  addressLine          String?
  timezone             String   @default("America/Los_Angeles")
  paymentTermsDays     Int      @default(14)
  enforceDocumentOrder Boolean  @default(true)
  termsAuthorization   String
  termsAcceptance      String
  termsInvoice         String
  remittanceInfo       String
  signingLinkDays      Int      @default(14)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users        User[]
  customers    Customer[]
  vehicles     Vehicle[]
  jobs         Job[]
  serviceTypes ServiceType[]
  counters     Counter[]
  auditLogs    AuditLog[]
}

model User {
  id           String    @id @default(cuid())
  orgId        String
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(TECHNICIAN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  org  Organization @relation(fields: [orgId], references: [id])
  jobs Job[]        @relation("JobTechnician")

  @@index([orgId])
}

model ServiceType {
  id        String  @id @default(cuid())
  orgId     String
  code      String
  label     String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
}

model Customer {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  email        String?
  phone        String?
  addressLine1 String?
  city         String?
  state        String?
  zip          String?
  notes        String?
  createdAt    DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id])
  contacts Contact[]
  vehicles Vehicle[]
  jobs     Job[]

  @@index([orgId, name])
}

model Contact {
  id                 String   @id @default(cuid())
  customerId         String
  name               String
  title              String?
  email              String?
  phone              String?
  isAuthorizedSigner Boolean  @default(true)
  createdAt          DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs     Job[]

  @@index([customerId])
}

model Vehicle {
  id           String   @id @default(cuid())
  orgId        String
  customerId   String?
  vin          String?
  year         Int?
  make         String
  model        String
  color        String?
  licensePlate String?
  createdAt    DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id])
  customer Customer?    @relation(fields: [customerId], references: [id])
  jobs     Job[]

  @@index([orgId, vin])
  @@index([orgId, licensePlate])
}

model Job {
  id              String    @id @default(cuid())
  orgId           String
  number          String
  customerId      String
  contactId       String?
  vehicleId       String
  technicianId    String?
  referenceNumber String? // Stock # / RO #
  status          JobStatus @default(AWAITING_AUTHORIZATION)
  // Denormalized read model, maintained by refreshJobSummary(). Keeps lists, dashboards and
  // overdue alerts as plain indexed SQL queries no matter how many jobs exist.
  serviceLabel    String?
  amountCents     Int?
  paidCents       Int       @default(0)
  dueDate         DateTime? @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org        Organization @relation(fields: [orgId], references: [id])
  customer   Customer     @relation(fields: [customerId], references: [id])
  contact    Contact?     @relation(fields: [contactId], references: [id])
  vehicle    Vehicle      @relation(fields: [vehicleId], references: [id])
  technician User?        @relation("JobTechnician", fields: [technicianId], references: [id])
  documents  Document[]
  payments   Payment[]
  photos     Photo[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([orgId, dueDate])
  @@index([customerId])
}

model Document {
  id        String       @id @default(cuid())
  jobId     String
  type      DocumentType
  number    String
  createdAt DateTime     @default(now())

  job      Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@unique([jobId, type])
  @@index([number])
}

model DocumentVersion {
  id          String        @id @default(cuid())
  documentId  String
  version     Int
  status      VersionStatus @default(DRAFT)
  payload     Json
  contentHash String?
  pdfPath     String?
  pdfSha256   String?
  createdById String?
  createdAt   DateTime      @default(now())
  sentAt      DateTime?
  signedAt    DateTime?
  voidedAt    DateTime?
  voidReason  String?

  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signingRequests SigningRequest[]
  signature       Signature?

  @@unique([documentId, version])
  @@index([status])
}

model SigningRequest {
  id                 String    @id @default(cuid())
  versionId          String
  tokenHash          String    @unique
  tokenCipher        String
  sentToEmail        String
  sentToName         String?
  requiresSignature  Boolean   @default(true)
  expiresAt          DateTime
  revokedAt          DateTime?
  firstViewedAt      DateTime?
  lastViewedAt       DateTime?
  viewCount          Int       @default(0)
  createdById        String?
  createdAt          DateTime  @default(now())

  version DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

model Signature {
  id                 String   @id @default(cuid())
  versionId          String   @unique
  signerName         String
  signerTitle        String?
  authorityConfirmed Boolean
  exceptions         String?
  signaturePath      String
  signatureSha256    String
  contentHash        String
  ip                 String?
  userAgent          String?
  provider           String   @default("internal")
  signedAt           DateTime @default(now())

  version DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String        @id @default(cuid())
  jobId        String
  amountCents  Int
  method       PaymentMethod
  paidAt       DateTime      @db.Date
  reference    String?
  recordedById String?
  createdAt    DateTime      @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Photo {
  id           String    @id @default(cuid())
  jobId        String
  kind         PhotoKind @default(OTHER)
  storagePath  String
  contentType  String
  caption      String?
  uploadedById String?
  createdAt    DateTime  @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Counter {
  orgId String
  key   String
  value Int    @default(0)

  org Organization @relation(fields: [orgId], references: [id])

  @@id([orgId, key])
}

model AuditLog {
  id          String    @id @default(cuid())
  seq         BigInt    @unique @default(autoincrement())
  orgId       String
  at          DateTime  @default(now())
  actorType   ActorType
  actorId     String?
  actorLabel  String
  action      String
  entityType  String
  entityId    String
  jobId       String?
  metadata    Json      @default("{}")
  ip          String?
  userAgent   String?
  prevHash    String?
  hash        String

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, seq])
  @@index([entityType, entityId])
  @@index([jobId])
}
